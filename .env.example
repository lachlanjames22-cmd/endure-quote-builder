# Copy these into Vercel → Project → Settings → Environment Variables.
# Do NOT commit real values — this file lists names + where to get them only.

# The FULL service-account JSON key, on one line (from Google Cloud → Service Account → Keys)
GOOGLE_SERVICE_ACCOUNT=

# Google Sheet holding the rate card (Shopping List + Assumptions tabs)
RATE_SHEET_ID=

# Drive folder ID for Operations → Incoming Jobs
INCOMING_JOBS_ID=

# Shared team password gate for the tool
TEAM_TOKEN=

# Ballpark email sending. Primary path is the Gmail API over HTTPS (Railway
# blocks outbound SMTP): enable the Gmail API in the service account's Cloud
# project, then in admin.google.com → Security → API controls → Domain-wide
# delegation authorise the service account's client_id for scope
# https://www.googleapis.com/auth/gmail.send. SEND_EMAIL_USER is the Workspace
# mailbox the mail sends as (Matt's address).
SEND_EMAIL_USER=
# Optional — only used by the SMTP fallback on hosts that allow mail ports
# (myaccount.google.com/apppasswords, needs 2-step verification ON)
SEND_EMAIL_APP_PASSWORD=
# Shared-inbox copy of every ballpark sent (BCC — invisible to the client)
SEND_BCC=
# Display name on outgoing mail
SEND_EMAIL_NAME=Matt — Endure Decks

# Accounts inbox for Site Assessment invoice requests (booking flow).
# Unset = Matt's booking email tells him to chase the invoice himself.
ACCOUNTS_EMAIL=
