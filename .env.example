# Copy these into Vercel → Project → Settings → Environment Variables.
# Do NOT commit real values — this file lists names + where to get them only.

# The FULL service-account JSON key, on one line (from Google Cloud → Service Account → Keys)
GOOGLE_SERVICE_ACCOUNT=

# Google Sheet holding the rate card (Shopping List + Assumptions tabs)
RATE_SHEET_ID=

# Drive folder ID for Operations → Incoming Jobs
INCOMING_JOBS_ID=

# Shared team password gate for the tool
TEAM_TOKEN=
